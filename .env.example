# Roz Clinic - local development environment (copy to .env)
# Values here are used by compose services; containers get host-specific
# overrides (db / redis) directly in infra/docker-compose.dev.yml
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://roz:roz_dev@localhost:5432/roz
REDIS_URL=redis://localhost:6379/0
