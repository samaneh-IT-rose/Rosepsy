{
 "paths": {
  "/api/v1/services": {
   "get": {
    "summary": "List Services"
   },
   "post": {
    "summary": "Create Service",
    "body": "ServiceIn"
   }
  },
  "/api/v1/services/{service_id}": {
   "patch": {
    "summary": "Patch Service",
    "body": "ServicePatchIn"
   }
  },
  "/api/v1/consultants": {
   "get": {
    "summary": "List Consultants"
   },
   "post": {
    "summary": "Create Consultant",
    "body": "ConsultantIn"
   }
  },
  "/api/v1/consultants/{consultant_id}/credentials": {
   "post": {
    "summary": "Add Credential",
    "body": "CredentialIn"
   }
  },
  "/api/v1/branches/{branch_id}/services": {
   "get": {
    "summary": "Branch Services"
   }
  },
  "/api/v1/consultants/{consultant_id}/availability-rules": {
   "get": {
    "summary": "Get Rules"
   }
  },
  "/api/v1/consultants/{consultant_id}/availability-exceptions": {
   "post": {
    "summary": "Add Exception",
    "body": "ExceptionIn"
   }
  },
  "/api/v1/consultants/{consultant_id}/availability-exceptions/{exception_id}": {
   "delete": {
    "summary": "Delete Exception"
   }
  },
  "/api/v1/consultants/{consultant_id}/availability": {
   "get": {
    "summary": "Free Slots"
   }
  },
  "/api/v1/booking-holds": {
   "post": {
    "summary": "Create Hold",
    "body": "HoldIn"
   }
  },
  "/api/v1/appointments": {
   "get": {
    "summary": "My Appointments"
   },
   "post": {
    "summary": "Create Appointment",
    "body": "AppointmentIn"
   }
  },
  "/api/v1/appointments/{appointment_id}": {
   "get": {
    "summary": "Get Appointment"
   }
  },
  "/api/v1/appointments/{appointment_id}/cancel": {
   "post": {
    "summary": "Cancel Appointment"
   }
  },
  "/api/v1/orders": {
   "post": {
    "summary": "Create Order",
    "body": "OrderIn"
   }
  },
  "/api/v1/orders/{order_id}": {
   "get": {
    "summary": "Get Order"
   }
  },
  "/api/v1/payments/start": {
   "post": {
    "summary": "Start Payment",
    "body": "PaymentStartIn"
   }
  },
  "/api/v1/payments/callback": {
   "post": {
    "summary": "Payments Callback",
    "body": "CallbackIn"
   }
  },
  "/api/v1/payments/{payment_id}": {
   "get": {
    "summary": "Get Payment"
   }
  },
  "/api/v1/invoices/{invoice_id}.pdf": {
   "get": {
    "summary": "Get Invoice Pdf"
   }
  },
  "/api/v1/invoices/{invoice_id}": {
   "get": {
    "summary": "Get Invoice"
   }
  },
  "/api/v1/consents": {
   "get": {
    "summary": "My Consents"
   },
   "post": {
    "summary": "Grant Consent",
    "body": "ConsentIn"
   }
  },
  "/api/v1/consents/{consent_id}/revoke": {
   "post": {
    "summary": "Revoke Consent"
   }
  },
  "/api/v1/consent-versions": {
   "post": {
    "summary": "Create Version",
    "body": "app__api__consents__VersionIn"
   }
  },
  "/api/v1/clinical-records": {
   "post": {
    "summary": "Create Record",
    "body": "RecordIn"
   }
  },
  "/api/v1/clinical-records/me": {
   "get": {
    "summary": "My Record"
   }
  },
  "/api/v1/clinical-records/{record_id}": {
   "get": {
    "summary": "Get Record"
   }
  },
  "/api/v1/clinical-records/{record_id}/files": {
   "post": {
    "summary": "Attach File",
    "body": "RecordFileIn"
   }
  },
  "/api/v1/clinical-records/{record_id}/submissions": {
   "get": {
    "summary": "Record Submissions"
   }
  },
  "/api/v1/encounters/mine": {
   "get": {
    "summary": "My Encounters"
   }
  },
  "/api/v1/encounters/{encounter_id}/record": {
   "get": {
    "summary": "Encounter Record"
   }
  },
  "/api/v1/encounters": {
   "post": {
    "summary": "Create Encounter",
    "body": "EncounterIn"
   }
  },
  "/api/v1/encounters/{encounter_id}/status": {
   "post": {
    "summary": "Set Encounter Status",
    "body": "StatusIn"
   }
  },
  "/api/v1/encounters/{encounter_id}": {
   "get": {
    "summary": "Get Encounter"
   }
  },
  "/api/v1/encounters/{encounter_id}/notes": {
   "get": {
    "summary": "Encounter Notes"
   },
   "post": {
    "summary": "Add Note",
    "body": "NoteIn"
   }
  }
 },
 "schemas": {
  "AppointmentIn": {
   "properties": {
    "hold_id": {
     "type": "string",
     "format": "uuid",
     "title": "Hold Id"
    }
   },
   "type": "object",
   "required": [
    "hold_id"
   ],
   "title": "AppointmentIn"
  },
  "CallbackIn": {
   "properties": {
    "gateway_ref": {
     "type": "string",
     "maxLength": 64,
     "minLength": 4,
     "title": "Gateway Ref"
    },
    "result": {
     "type": "string",
     "pattern": "^(success|failure)$",
     "title": "Result"
    }
   },
   "type": "object",
   "required": [
    "gateway_ref",
    "result"
   ],
   "title": "CallbackIn"
  },
  "ConsentIn": {
   "properties": {
    "kind": {
     "type": "string",
     "maxLength": 32,
     "minLength": 2,
     "title": "Kind"
    },
    "channel": {
     "type": "string",
     "pattern": "^[a-z_]{2,20}$",
     "title": "Channel",
     "default": "web"
    }
   },
   "type": "object",
   "required": [
    "kind"
   ],
   "title": "ConsentIn"
  },
  "ConsultantIn": {
   "properties": {
    "display_name": {
     "type": "string",
     "maxLength": 120,
     "minLength": 2,
     "title": "Display Name"
    },
    "specialty_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ],
     "title": "Specialty Id"
    },
    "bio": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 2000
      },
      {
       "type": "null"
      }
     ],
     "title": "Bio"
    },
    "user_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ],
     "title": "User Id"
    }
   },
   "type": "object",
   "required": [
    "display_name"
   ],
   "title": "ConsultantIn"
  },
  "CredentialIn": {
   "properties": {
    "kind": {
     "type": "string",
     "pattern": "^(degree|license|certificate)$",
     "title": "Kind"
    },
    "title": {
     "type": "string",
     "maxLength": 150,
     "minLength": 2,
     "title": "Title"
    },
    "license_number": {
     "type": "string",
     "maxLength": 64,
     "minLength": 1,
     "title": "License Number"
    },
    "issued_by": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 150
      },
      {
       "type": "null"
      }
     ],
     "title": "Issued By"
    },
    "issued_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ],
     "title": "Issued At"
    },
    "expires_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ],
     "title": "Expires At"
    }
   },
   "type": "object",
   "required": [
    "kind",
    "title",
    "license_number"
   ],
   "title": "CredentialIn"
  },
  "EncounterIn": {
   "properties": {
    "record_id": {
     "type": "string",
     "format": "uuid",
     "title": "Record Id"
    },
    "consultant_id": {
     "type": "string",
     "format": "uuid",
     "title": "Consultant Id"
    },
    "start_at": {
     "type": "string",
     "format": "date-time",
     "title": "Start At"
    },
    "end_at": {
     "type": "string",
     "format": "date-time",
     "title": "End At"
    },
    "appointment_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ],
     "title": "Appointment Id"
    }
   },
   "type": "object",
   "required": [
    "record_id",
    "consultant_id",
    "start_at",
    "end_at"
   ],
   "title": "EncounterIn"
  },
  "ExceptionIn": {
   "properties": {
    "start_at": {
     "type": "string",
     "format": "date-time",
     "title": "Start At"
    },
    "end_at": {
     "type": "string",
     "format": "date-time",
     "title": "End At"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 300
      },
      {
       "type": "null"
      }
     ],
     "title": "Reason"
    }
   },
   "type": "object",
   "required": [
    "start_at",
    "end_at"
   ],
   "title": "ExceptionIn"
  },
  "HoldIn": {
   "properties": {
    "consultant_id": {
     "type": "string",
     "format": "uuid",
     "title": "Consultant Id"
    },
    "service_id": {
     "type": "string",
     "format": "uuid",
     "title": "Service Id"
    },
    "branch_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ],
     "title": "Branch Id"
    },
    "start_at": {
     "type": "string",
     "format": "date-time",
     "title": "Start At"
    },
    "duration_minutes": {
     "anyOf": [
      {
       "type": "integer",
       "maximum": 600.0,
       "exclusiveMinimum": 0.0
      },
      {
       "type": "null"
      }
     ],
     "title": "Duration Minutes"
    }
   },
   "type": "object",
   "required": [
    "consultant_id",
    "service_id",
    "start_at"
   ],
   "title": "HoldIn"
  },
  "NoteIn": {
   "properties": {
    "body": {
     "type": "string",
     "maxLength": 5000,
     "minLength": 2,
     "title": "Body"
    }
   },
   "type": "object",
   "required": [
    "body"
   ],
   "title": "NoteIn"
  },
  "OrderIn": {
   "properties": {
    "appointment_id": {
     "type": "string",
     "format": "uuid",
     "title": "Appointment Id"
    }
   },
   "type": "object",
   "required": [
    "appointment_id"
   ],
   "title": "OrderIn"
  },
  "PaymentStartIn": {
   "properties": {
    "order_id": {
     "type": "string",
     "format": "uuid",
     "title": "Order Id"
    }
   },
   "type": "object",
   "required": [
    "order_id"
   ],
   "title": "PaymentStartIn"
  },
  "RecordFileIn": {
   "properties": {
    "file_id": {
     "type": "string",
     "format": "uuid",
     "title": "File Id"
    }
   },
   "type": "object",
   "required": [
    "file_id"
   ],
   "title": "RecordFileIn"
  },
  "RecordIn": {
   "properties": {
    "user_id": {
     "type": "string",
     "format": "uuid",
     "title": "User Id"
    },
    "summary": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 1000
      },
      {
       "type": "null"
      }
     ],
     "title": "Summary"
    },
    "risk_level": {
     "type": "string",
     "pattern": "^(low|medium|high|unknown)$",
     "title": "Risk Level",
     "default": "unknown"
    }
   },
   "type": "object",
   "required": [
    "user_id"
   ],
   "title": "RecordIn"
  },
  "ServiceIn": {
   "properties": {
    "name": {
     "type": "string",
     "maxLength": 150,
     "minLength": 2,
     "title": "Name"
    },
    "specialty_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ],
     "title": "Specialty Id"
    },
    "duration_minutes": {
     "type": "integer",
     "maximum": 600.0,
     "exclusiveMinimum": 0.0,
     "title": "Duration Minutes"
    },
    "session_type": {
     "type": "string",
     "pattern": "^(in_person|online)$",
     "title": "Session Type",
     "default": "in_person"
    },
    "is_active": {
     "type": "boolean",
     "title": "Is Active",
     "default": true
    }
   },
   "type": "object",
   "required": [
    "name",
    "duration_minutes"
   ],
   "title": "ServiceIn"
  },
  "ServicePatchIn": {
   "properties": {
    "name": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 150,
       "minLength": 2
      },
      {
       "type": "null"
      }
     ],
     "title": "Name"
    },
    "duration_minutes": {
     "anyOf": [
      {
       "type": "integer",
       "maximum": 600.0,
       "exclusiveMinimum": 0.0
      },
      {
       "type": "null"
      }
     ],
     "title": "Duration Minutes"
    },
    "is_active": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "title": "Is Active"
    }
   },
   "type": "object",
   "title": "ServicePatchIn"
  },
  "StatusIn": {
   "properties": {
    "status": {
     "type": "string",
     "pattern": "^(in_progress|completed|cancelled|no_show)$",
     "title": "Status"
    }
   },
   "type": "object",
   "required": [
    "status"
   ],
   "title": "StatusIn"
  },
  "app__api__consents__VersionIn": {
   "properties": {
    "kind": {
     "type": "string",
     "maxLength": 32,
     "minLength": 2,
     "title": "Kind"
    },
    "title_fa": {
     "type": "string",
     "maxLength": 150,
     "minLength": 2,
     "title": "Title Fa"
    },
    "text_fa": {
     "type": "string",
     "maxLength": 5000,
     "minLength": 10,
     "title": "Text Fa"
    }
   },
   "type": "object",
   "required": [
    "kind",
    "title_fa",
    "text_fa"
   ],
   "title": "VersionIn"
  }
 }
}